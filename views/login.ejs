<% const title = "Login" %>
<%- include('partials/head', { title }); %>
<body>
<%- include('partials/dashboard'); %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <% if (messages.error) { %>
        <p class="alert alert-danger"><%= messages.error %></p>
      <% } %>
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h2 class="card-title mb-4">Log in to your account</h2>
          <form action="/login" method="POST">
            <div class="mb-3">
              <label for="email" class="form-label fw-bold">Username/E-mail</label>
              <input type="text" id="email" name="email" class="form-control" placeholder="Username/E-mail..." required />
            </div>
            <div class="mb-3">
              <label for="password" class="form-label fw-bold">Password</label>
              <input type="password" id="password" name="password" class="form-control" placeholder="Password..." required />
            </div>
            <button type="submit" class="btn btn-mars w-100">Login</button>
            <p class="text-center mt-3 mb-0">Not a user? <a href="/register">Register</a></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer'); %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
