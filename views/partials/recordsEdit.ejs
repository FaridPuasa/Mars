



<div id="editRecords">
    <div class = "container-fluid" style="padding-top: 50px">
        <div class = "row align-items-start">
            <div class="col-md-1"></div>
            <div class="col-md-10 mars-declaration-wrapper">

    <h3>Edit Declaration</h3>
    <form id ="recordsEdit" action = "/recordsEdit" method="POST">

        <!-- PAGE 1 -->
        <div class="recordsEditPage">
        <div class="row">
            <div class="col leftcolumn">
                <div class="mars-meta-bar">
                    <div>
                    <label for="date">Date Granted:</label>
                    <% var todayDate = new Date(); %>
                    <% var dd = String(todayDate.getDate()).padStart(2, '0'); %>
                    <% var mm = String(todayDate.getMonth() + 1).padStart(2, '0'); //January is 0! %>
                    <% var yyyy = todayDate.getFullYear(); %>

                    <% todayDate = yyyy + "-" + mm + "-" + dd; %>
                    <input type="date" id="dateGranted" name="dateGranted" value="<%= declaration3.dateGranted %>" size="30"/>
                    </div>
                    <div>
                    <label for="date">Departure Date:</label>
                    <input type="date" id="departureDate" name="departureDate" size="30" value="<%= declaration3.departureDate %>"/>
                    <input type="text" id="_id" name="_id" size="30" value="<%= declaration3._id %>" style="display:none"/>
                    </div>
                    <div>
                    <!--CEPT Option Normal/Cept-->
                    <label for="date">CEPT:</label>
                    <select name="cept" id="cept">
                        <option value="normal" <%= declaration3.cept==='normal' ? 'selected' : '' %>>Normal</option>
                        <option value="cept" <%= declaration3.cept==='cept' ? 'selected' : '' %>>CEPT</option>
                    </select>
                    </div>
                </div>
                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Procedure</div>
                    <div class="card-body">
                    <div class="row g-3">
                      <div class="col-md-8">
                        <label class="form-label">Custom Procedure <span class="text-danger">*</span></label>
                        <select name="customsProcedure" id="customsProcedure" class="form-select" onchange="autoCodeCustomProcedure()">
                            <optgroup label="-">
                                <!--code 05--><option value="IMP" <%= declaration3.Procedure.customsProcedure==='IMP' ? 'selected' : '' %>>IMPORT</option>
                                <!--code 07--><option value="REIMP" <%= declaration3.Procedure.customsProcedure==='REIMP' ? 'selected' : '' %>>RE-IMPORT</option>
                                <!--code 10--><option value="ENTRYTOBOND" <%= declaration3.Procedure.customsProcedure==='ENTRYTOBOND' ? 'selected' : '' %>>ENTRY TO BOND (WAREHOUSE)</option>
                                <!--code 11--><option value="TEMPIMP" <%= declaration3.Procedure.customsProcedure==='TEMPIMP' ? 'selected' : '' %>>TEMPORARY IMPORT</option>
                                <!--code 15--><option value="TEMPIMPEXT" <%= declaration3.Procedure.customsProcedure==='TEMPIMPEXT' ? 'selected' : '' %>>TEMPORARY IMPORT (EXTENSION)</option>
                                <!--code 09--><option value="IMPFROMBOND" <%= declaration3.Procedure.customsProcedure==='IMPFROMBOND' ? 'selected' : '' %>>IMPORTATION FROM BOND (WAREHOUSE)</option>
                            </optgroup>
                            <optgroup label="-">
                                <!--code 06--><option value="EXP" <%= declaration3.Procedure.customsProcedure==='EXP' ? 'selected' : '' %>>EXPORT</option>
                                <!--code 08--><option value="REEXP" <%= declaration3.Procedure.customsProcedure==='REEXP' ? 'selected' : '' %>>RE-EXPORT</option>
                                <!--code 16--><option value="TEMPEXP" <%= declaration3.Procedure.customsProcedure==='TEMPEXP' ? 'selected' : '' %>>TEMPORARY EXPORT</option>
                                <!--code 14--><option value="EXPFROMBOND" <%= declaration3.Procedure.customsProcedure==='EXPFROMBOND' ? 'selected' : '' %>>EXPORT FROM BOND (WAREHOUSE)</option>
                            </optgroup>
                                <!--code 12--><option value="TRANSIT" <%= declaration3.Procedure.customsProcedure==='TRANSIT' ? 'selected' : '' %>>TRANSIT</option>
                                <!--code 13--><option value="BONDEDMOVGOODS" <%= declaration3.Procedure.customsProcedure==='BONDEDMOVGOODS' ? 'selected' : '' %>>BONDED MOVEMENT OF GOODS (BETWEEN WAREHOUSE)</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="customsProcedureCode" name="customsProcedureCode" class="form-control" value="05"/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Prev Procedure</label>
                        <select name="previousProcedure" id="previousProcedure" class="form-select" onchange="autoCodePrevProcedure()">
                                <option value=""></option>
                            <optgroup label="-">
                                <!--code 05--><option value="IMP" <%= declaration3.Procedure.previousProcedure==='IMP' ? 'selected' : '' %>>IMPORT</option>
                                <!--code 07--><option value="REIMP" <%= declaration3.Procedure.previousProcedure==='REIMP' ? 'selected' : '' %>>RE-IMPORT</option>
                                <!--code 10--><option value="ENTRYTOBOND" <%= declaration3.Procedure.previousProcedure==='ENTRYTOBOND' ? 'selected' : '' %>>ENTRY TO BOND (WAREHOUSE)</option>
                                <!--code 11--><option value="TEMPIMP" <%= declaration3.Procedure.previousProcedure==='TEMPIMP' ? 'selected' : '' %>>TEMPORARY IMPORT</option>
                                <!--code 15--><option value="TEMPIMPEXT" <%= declaration3.Procedure.previousProcedure==='TEMPIMPEXT' ? 'selected' : '' %>>TEMPORARY IMPORT (EXTENSION)</option>
                                <!--code 09--><option value="IMPFROMBOND" <%= declaration3.Procedure.previousProcedure==='IMPFROMBOND' ? 'selected' : '' %>>IMPORTATION FROM BOND (WAREHOUSE)</option>
                            </optgroup>
                            <optgroup label="-">
                                <!--code 06--><option value="EXP" <%= declaration3.Procedure.previousProcedure==='EXP' ? 'selected' : '' %>>EXPORT</option>
                                <!--code 08--><option value="REEXP" <%= declaration3.Procedure.previousProcedure==='REEXP' ? 'selected' : '' %>>RE-EXPORT</option>
                                <!--code 16--><option value="TEMPEXP" <%= declaration3.Procedure.previousProcedure==='TEMPEXP' ? 'selected' : '' %>>TEMPORARY EXPORT</option>
                                <!--code 14--><option value="EXPFROMBOND" <%= declaration3.Procedure.previousProcedure==='EXPFROMBOND' ? 'selected' : '' %>>EXPORT FROM BOND (WAREHOUSE)</option>
                            </optgroup>
                                <!--code 12--><option value="TRANSIT" <%= declaration3.Procedure.previousProcedure==='TRANSIT' ? 'selected' : '' %>>TRANSIT</option>
                                <!--code 13--><option value="BONDEDMOVGOODS" <%= declaration3.Procedure.previousProcedure==='BONDEDMOVGOODS' ? 'selected' : '' %>>BONDED MOVEMENT OF GOODS (BETWEEN WAREHOUSE)</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="previousProcedureCode" name="previousProcedureCode" class="form-control"/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Dutiable Indicator <span class="text-danger">*</span></label>
                        <select name="dutiableIndicator" id="dutiableIndicator" class="form-select" onchange="autoCodeDutiable()">
                            <!--code A--><option value="A" <%= declaration3.Procedure.dutiableIndicatorCode==='A' ? 'selected' : '' %>>AIR</option>
                            <!--code B--><option value="N" <%= declaration3.Procedure.dutiableIndicatorCode==='N' ? 'selected' : '' %>>SEA</option>
                            <!--code C--><option value="L" <%= declaration3.Procedure.dutiableIndicatorCode==='L' ? 'selected' : '' %>>LAND</option>
                            <!--code D--><option value="P" <%= declaration3.Procedure.dutiableIndicatorCode==='P' ? 'selected' : '' %>>POSTAL</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="dutiableIndicatorCode" name="dutiableIndicatorCode" class="form-control" value="A"/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Clearance Station <span class="text-danger">*</span></label>
                        <select name="clearanceStation" id="clearanceStation" class="form-select" onchange="autoCodeClearance()">
                            <!--code 611--><option value="BSB" <%= declaration3.Procedure.clearanceStation==='BSB' ? 'selected' : '' %>>BSB</option>
                            <!--code 603--><option value="BSP WHARF" <%= declaration3.Procedure.clearanceStation==='BSP WHARF' ? 'selected' : '' %>>BSP WHARF</option>
                            <!--code 611--><option value="BSP WHARF + LONG ROOM" <%= declaration3.Procedure.clearanceStation==='BSP WHARF + LONG ROOM' ? 'selected' : '' %>>BSP WHARF + LONG ROOM</option>
                            <!--code 600--><option value="CUSTOMS HEADQUARTERS" <%= declaration3.Procedure.clearanceStation==='CUSTOMS HEADQUARTERS' ? 'selected' : '' %>>CUSTOMS HEADQUARTERS</option>
                            <!--code 601--><option value="INTERNATIONAL AIRPORT (CARGO)" <%= declaration3.Procedure.clearanceStation==='INTERNATIONAL AIRPORT (CARGO)' ? 'selected' : '' %>>INTERNATIONAL AIRPORT (CARGO)</option>
                            <!--code 609--><option value="INTERNATIONAL AIRPORT (PASSENGER)" <%= declaration3.Procedure.clearanceStation==='INTERNATIONAL AIRPORT (PASSENGER)' ? 'selected' : '' %>>INTERNATIONAL AIRPORT (PASSENGER)</option>
                            <!--code 622--><option value="KUALA BELAIT POST OFFICE" <%= declaration3.Procedure.clearanceStation==='KUALA BELAIT POST OFFICE' ? 'selected' : '' %>>KUALA BELAIT POST OFFICE</option>
                            <!--code 602--><option value="KUALA BELAIT WHARF" <%= declaration3.Procedure.clearanceStation==='KUALA BELAIT WHARF' ? 'selected' : '' %>>KUALA BELAIT WHARF</option>
                            <!--code 631--><option value="KUALA LURAH" <%= declaration3.Procedure.clearanceStation==='KUALA LURAH' ? 'selected' : '' %>>KUALA LURAH</option>
                            <!--code 621--><option value="MAIL PROCESSING CENTRE" <%= declaration3.Procedure.clearanceStation==='MAIL PROCESSING CENTRE' ? 'selected' : '' %>>MAIL PROCESSING CENTRE</option>
                            <!--code 616--><option value="MUARA CONTAINER" <%= declaration3.Procedure.clearanceStation==='MUARA CONTAINER' ? 'selected' : '' %>>MUARA CONTAINER</option>
                            <!--code 617--><option value="MUARA GUARD HOUSE" <%= declaration3.Procedure.clearanceStation==='MUARA GUARD HOUSE' ? 'selected' : '' %>>MUARA GUARD HOUSE</option>
                            <!--code 605--><option value="MUARA PORT" <%= declaration3.Procedure.clearanceStation==='MUARA PORT' ? 'selected' : '' %>>MUARA PORT</option>
                            <!--code 615--><option value="MUARA POST OFFICE" <%= declaration3.Procedure.clearanceStation==='MUARA POST OFFICE' ? 'selected' : '' %>>MUARA POST OFFICE</option>
                            <!--code 620--><option value="PUTAT" <%= declaration3.Procedure.clearanceStation==='PUTAT' ? 'selected' : '' %>>PUTAT</option>
                            <!--code 608--><option value="SERASA FERRY TERMINAL" <%= declaration3.Procedure.clearanceStation==='SERASA FERRY TERMINAL' ? 'selected' : '' %>>SERASA FERRY TERMINAL</option>
                            <!--code 618--><option value="SERASA FERRY NEW TERMINAL" <%= declaration3.Procedure.clearanceStation==='SERASA FERRY NEW TERMINAL' ? 'selected' : '' %>>SERASA NEW FERRY TERMINAL</option>
                            <!--code 623--><option value="SERIA POST OFFICE" <%= declaration3.Procedure.clearanceStation==='SERIA POST OFFICE' ? 'selected' : '' %>>SERIA POST OFFICE</option>
                            <!--code 612--><option value="SUNGAI TUJOH" <%= declaration3.Procedure.clearanceStation==='SUNGAI TUJOH' ? 'selected' : '' %>>SUNGAI TUJOH</option>
                            <!--code 634--><option value="TEMBURONG LABU" <%= declaration3.Procedure.clearanceStation==='TEMBURONG LABU' ? 'selected' : '' %>>TEMBURONG LABU</option>
                            <!--code 614--><option value="TEMBURONG POST OFFICE" <%= declaration3.Procedure.clearanceStation==='TEMBURONG POST OFFICE' ? 'selected' : '' %>>TEMBURONG POST OFFICE</option>
                            <!--code 604--><option value="TEMBURONG WHARF (BANGAR)" <%= declaration3.Procedure.clearanceStation==='TEMBURONG WHARF (BANGAR)' ? 'selected' : '' %>>TEMBURONG WHARF (BANGAR)</option>
                            <!--code 607--><option value="TUTONG POST OFFICE" <%= declaration3.Procedure.clearanceStation==='TUTONG POST OFFICE' ? 'selected' : '' %>>TUTONG POST OFFICE</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="clearanceStationCode" name="clearanceStationCode" class="form-control" value="611" required/>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Exporter / Consigner</div>
                    <div class="card-body">
                    <div class="mb-3">
                      <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label">Pick existing customer (optional)</label>
                        <a href="/customers" target="_blank" class="small">+ Add customer</a>
                      </div>
                      <select id="exporterCustomerPicker" class="form-select" onchange="fillExporterFromCustomer(this)">
                        <option value="">-- Pick existing customer (optional) --</option>
                        <% for (var e=0; e<consignee.length; e++) { %>
                          <option value="<%= e %>" data-name="<%= consignee[e].name %>" data-address="<%= consignee[e].address %>" data-reg="<%= consignee[e].reg %>" data-country="<%= consignee[e].country %>" data-phone="<%= consignee[e].telephone %>" data-postal="<%= consignee[e].postal %>"><%= consignee[e].name %></option>
                        <% } %>
                      </select>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label">Name</label>
                        <input type="text" id="exporterName" name="exporterName" class="form-control" value="<%= declaration3.Exporter.exporterName %>"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <input type="text" id="exporterAddress" name="exporterAddress" class="form-control" value="<%= declaration3.Exporter.exporterAddress %>"/>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Registration</label>
                        <input type="text" id="exporterRegistration" name="exporterRegistration" class="form-control" value="<%= declaration3.Exporter.exporterRegistration %>"/>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Country</label>
                        <%
                          var exporterCountryVal = declaration3.Exporter.exporterCountry || "";
                          var exporterCountryMatched = iso_countrycodes.some(function(cc) { return cc.name.toLowerCase() === exporterCountryVal.toLowerCase(); });
                        %>
                        <select id="exporterCountry" name="exporterCountry" class="form-select">
                          <option value=""></option>
                          <% if (exporterCountryVal && !exporterCountryMatched) { %>
                            <option value="<%= exporterCountryVal %>" selected><%= exporterCountryVal %> (legacy value)</option>
                          <% } %>
                          <% for (var c=0; c<iso_countrycodes.length; c++) { %>
                            <option value="<%= iso_countrycodes[c].name %>" <%= iso_countrycodes[c].name.toLowerCase() === exporterCountryVal.toLowerCase() ? 'selected' : '' %>><%= iso_countrycodes[c].name %></option>
                          <% } %>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Telephone</label>
                        <input type="text" id="exporterPhone" name="exporterPhone" class="form-control" value="<%= declaration3.Exporter.exporterPhone %>"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Postal</label>
                        <input type="text" id="exporterPostal" name="exporterPostal" class="form-control" value="<%= declaration3.Exporter.exporterPostal %>"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Transport</label>
                        <input type="text" id="exporterTransport" name="exporterTransport" class="form-control" value="<%= declaration3.Exporter.exporterTransport %>"/>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
            <!-- end left col-->
            <div class="col rightcolumn">
                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Importer / Consignee</div>
                    <div class="card-body">
                    <div class="mb-3">
                      <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label">Pick existing customer</label>
                        <a href="/customers" target="_blank" class="small">+ Add customer</a>
                      </div>
                      <select id="importerCustomerPicker" class="form-select" onchange="fillImporterFromCustomer(this)">
                        <option value="">-- Pick existing customer --</option>
                        <% for (var e=0; e<consignee.length; e++) { %>
                          <option value="<%= e %>" data-name="<%= consignee[e].name %>" data-address="<%= consignee[e].address %>" data-reg="<%= consignee[e].reg %>" data-ic="<%= consignee[e].ic %>" data-iccolor="<%= consignee[e].icColor %>" data-phone="<%= consignee[e].telephone %>" data-postal="<%= consignee[e].postal %>"><%= consignee[e].name %></option>
                        <% } %>
                      </select>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-4">
                        <label class="form-label">Type <span class="text-danger">*</span></label>
                        <select name="importerType" id="importerType" class="form-select" onchange="autoImporterIdReg()">
                            <option value="TRDR" <%= declaration3.Importer.importerType==='TRDR' ? 'selected' : '' %>>TRDR</option>
                            <option value="INDV" <%= declaration3.Importer.importerType==='INDV' ? 'selected' : '' %>>INDV</option>
                        </select>
                      </div>
                      <div class="col-md-8"></div>
                      <div class="col-md-6">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" id="importerName" name="importerName" class="form-control" value="<%= declaration3.Importer.importerName %>" required/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Address <span class="text-danger">*</span></label>
                        <textarea id="importerAddress" name="importerAddress" class="form-control" rows="2" required><%= declaration3.Importer.importerAddress %></textarea>
                      </div>
                      <div class="col-md-6" id="importerTRDR2">
                        <label class="form-label" id="importerTRDR1">Reg <span class="text-danger">*</span></label>
                        <input type="text" id="regTraderCoyRegNo" name="regTraderCoyRegNo" class="form-control" value="<%= declaration3.Importer.regTraderCoyRegNo %>"/>
                      </div>
                      <div class="col-md-6" id="importerINDV2" style="display:none">
                        <label class="form-label" id="importerINDV1">IC/PP <span class="text-danger">*</span></label>
                        <input type="text" id="importerRegistration" name="importerRegistration" class="form-control mb-2" value="<%= declaration3.Importer.importerRegistration %>"/>
                        <label class="form-label">IC Color</label>
                        <input type="text" id="importerICColor" name="importerICColor" class="form-control" value="<%= declaration3.Importer.importerICColor %>"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Telephone <span class="text-danger">*</span></label>
                        <input type="text" id="importerPhone" name="importerPhone" class="form-control" value="<%= declaration3.Importer.importerPhone %>"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Postal <span class="text-danger">*</span></label>
                        <input type="text" id="importerPostal" name="importerPostal" class="form-control" value="<%= declaration3.Importer.importerPostal %>"/>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Agent</div>
                    <div class="card-body">
                    <div class="mb-3">
                      <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label">Pick existing customer</label>
                        <a href="/customers" target="_blank" class="small">+ Add customer</a>
                      </div>
                      <select id="agentCustomerPicker" class="form-select" onchange="fillAgentFromCustomer(this)">
                        <option value="">-- Pick existing customer --</option>
                        <% for (var e=0; e<consignee.length; e++) { %>
                          <option value="<%= e %>" data-name="<%= consignee[e].name %>" data-address="<%= consignee[e].address %>" data-reg="<%= consignee[e].reg %>" data-phone="<%= consignee[e].telephone %>" data-postal="<%= consignee[e].postal %>"><%= consignee[e].name %></option>
                        <% } %>
                      </select>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" id="agentName" name="agentName" class="form-control" value="<%= declaration3.Agent.agentName %>"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Address <span class="text-danger">*</span></label>
                        <input type="text" id="agentAddress" name="agentAddress" class="form-control" value="<%= declaration3.Agent.agentAddress %>"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Registration <span class="text-danger">*</span></label>
                        <input type="text" id="agentRegistration" name="agentRegistration" class="form-control" value="<%= declaration3.Agent.agentRegistration %>"/>
                      </div>
                      <div class="col-md-3">
                        <label class="form-label">Telephone <span class="text-danger">*</span></label>
                        <input type="text" id="agentPhone" name="agentPhone" class="form-control" value="<%= declaration3.Agent.agentPhone %>"/>
                      </div>
                      <div class="col-md-3">
                        <label class="form-label">Postal <span class="text-danger">*</span></label>
                        <input type="text" id="agentPostal" name="agentPostal" class="form-control" value="<%= declaration3.Agent.agentPostal %>"/>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
        </div>
        </div>
        <!-- PAGE 1 ENDS -->
        <!-- PAGE 2 -->
        <div class="recordsEditPage" style="display:none">
        <div class="row">
            <div class="col leftcolumn">
                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Transport</div>
                    <div class="card-body">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label">Arrival Date <span class="text-danger">*</span></label>
                        <input type="date" id="arrivalDate" name="arrivalDate" class="form-control" value="<%= declaration3.Transport.arrivalDate %>" required/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Vessel Number <span class="text-danger">*</span></label>
                        <input type="text" id="vesselNo" name="vesselNo" class="form-control" value="<%= declaration3.Transport.vesselNo %>" required/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Vessel Name <span class="text-danger">*</span></label>
                        <input type="text" id="vesselName" name="vesselName" class="form-control" value="<%= declaration3.Transport.vesselName %>" required/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">BL/DO/AWB <span class="text-danger">*</span></label>
                        <input type="text" id="bldoawb" name="bldoawb" class="form-control" value="<%= declaration3.Transport.bldoawb %>" required/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">HB/HAWB</label>
                        <input type="text" id="hbhawb" name="hbhawb" class="form-control" value="<%= declaration3.Transport.hbhawb %>"/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Country Shipment <span class="text-danger">*</span></label>
                        <%
                          var countryShipmentVal = declaration3.Transport.countryShipment || "";
                          var countryShipmentMatched = iso_countrycodes.some(function(cc) { return cc.name.toLowerCase() === countryShipmentVal.toLowerCase(); });
                        %>
                        <select id="countryShipment" name="countryShipment" class="form-select" required onchange="fillCountryCode(this, 'countryShipmentCode')">
                          <option value=""></option>
                          <% if (countryShipmentVal && !countryShipmentMatched) { %>
                            <option value="<%= countryShipmentVal %>" selected><%= countryShipmentVal %> (legacy value)</option>
                          <% } %>
                          <% for (var c=0; c<iso_countrycodes.length; c++) { %>
                            <option value="<%= iso_countrycodes[c].name %>" data-code="<%= iso_countrycodes[c].alpha2 %>" <%= iso_countrycodes[c].name.toLowerCase() === countryShipmentVal.toLowerCase() ? 'selected' : '' %>><%= iso_countrycodes[c].name %></option>
                          <% } %>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
