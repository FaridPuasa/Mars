<% const title = "Unlocode Port List" %>
<%- include('partials/head', { title }); %>
<body>
<%- include('partials/dashboard'); %>

<div class="container-fluid py-4" style="max-width: 1200px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Unlocode Port List</h1>
    <button type="button" class="btn btn-mars" data-bs-toggle="modal" data-bs-target="#addUnlocodeModal">Add Port</button>
  </div>

  <% if (messages.error) { %>
    <p class="alert alert-danger"><%= messages.error %></p>
  <% } %>

  <%- include('partials/pagination', { baseUrl: '/unlocodeportlist', currentPage, totalPages, q, totalCount }); %>

  <div class="table-responsive">
    <table class="table table-striped table-bordered table-sm align-middle">
      <thead>
        <tr>
          <th scope="col">Country</th>
          <th scope="col">Location</th>
          <th scope="col">Code</th>
          <th scope="col">Name</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        <% unlocode_port_list.forEach(function(p) { %>
        <tr>
          <td style="width: 80px"><%= p.Country %></td>
          <td style="width: 80px"><%= p.Location %></td>
          <td style="width: 130px"><%= p.Country %><%= p.Location %></td>
          <td><%= p.Name %></td>
          <td class="text-nowrap">
            <button type="button" class="btn btn-sm btn-outline-primary edit-unlocode-btn"
              data-id="<%= p._id %>" data-country="<%= p.Country %>" data-location="<%= p.Location %>" data-name="<%= p.Name %>">Edit</button>
            <% if (username.designation === 'Admin') { %>
            <button type="button" class="btn btn-sm btn-outline-danger delete-unlocode-btn"
              data-id="<%= p._id %>" data-label="<%= p.Name %>">Delete</button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <%- include('partials/pagination', { baseUrl: '/unlocodeportlist', currentPage, totalPages, q, totalCount }); %>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addUnlocodeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" action="/unlocodeportlist/create" method="POST">
      <div class="modal-header">
        <h5 class="modal-title">Add Port</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" name="page" value="<%= currentPage %>">
        <input type="hidden" name="q" value="<%= q %>">
        <div class="mb-2"><label class="form-label">Country</label><input type="text" name="Country" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Location</label><input type="text" name="Location" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Name</label><input type="text" name="Name" class="form-control" required></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-mars">Add</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editUnlocodeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" action="/unlocodeportlist/update" method="POST">
      <div class="modal-header">
        <h5 class="modal-title">Edit Port</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" name="_id" id="editUnlocodeId">
        <input type="hidden" name="page" value="<%= currentPage %>">
        <input type="hidden" name="q" value="<%= q %>">
        <div class="mb-2"><label class="form-label">Country</label><input type="text" name="Country" id="editCountry" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Location</label><input type="text" name="Location" id="editLocation" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Name</label><input type="text" name="Name" id="editName" class="form-control" required></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-mars">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteUnlocodeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" id="deleteUnlocodeForm" method="POST">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Delete port <strong id="deleteUnlocodeLabel"></strong>? This cannot be undone.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer'); %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.querySelectorAll('.edit-unlocode-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('editUnlocodeId').value = btn.dataset.id;
      document.getElementById('editCountry').value = btn.dataset.country;
      document.getElementById('editLocation').value = btn.dataset.location;
      document.getElementById('editName').value = btn.dataset.name;
      new bootstrap.Modal(document.getElementById('editUnlocodeModal')).show();
    });
  });

  document.querySelectorAll('.delete-unlocode-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('deleteUnlocodeLabel').textContent = btn.dataset.label;
      document.getElementById('deleteUnlocodeForm').action =
        '/unlocodeportlist/delete/' + btn.dataset.id + '?page=<%= currentPage %>&q=<%= encodeURIComponent(q) %>';
      new bootstrap.Modal(document.getElementById('deleteUnlocodeModal')).show();
    });
  });
</script>
</body>
</html>
