<% const title = "MARS" %>
<%- include('partials/head', { title }); %>
<body>
<%- include('partials/dashboard'); %>

<div class="container py-4">
  <div class="row g-4 justify-content-center">
    <div class="col-6 col-md-3">
      <a href="/bdnsw" class="text-decoration-none">
        <div class="card h-100 text-center border-0 shadow-sm mars-tile">
          <div class="card-body">
            <img src="/images/bdnsw.png" alt="" class="mars-tile-icon mb-2">
            <div class="card-title fw-semibold text-dark">Single Window</div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a href="/wip" class="text-decoration-none">
        <div class="card h-100 text-center border-0 shadow-sm mars-tile">
          <div class="card-body">
            <img src="/images/category.png" alt="" class="mars-tile-icon mb-2">
            <div class="card-title fw-semibold text-dark">Category</div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a href="/hscode" class="text-decoration-none">
        <div class="card h-100 text-center border-0 shadow-sm mars-tile">
          <div class="card-body">
            <img src="/images/HSCODE.png" alt="" class="mars-tile-icon mb-2">
            <div class="card-title fw-semibold text-dark">HS Code</div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a href="/unlocodeportlist" class="text-decoration-none">
        <div class="card h-100 text-center border-0 shadow-sm mars-tile">
          <div class="card-body">
            <img src="/images/ship.png" alt="" class="mars-tile-icon mb-2">
            <div class="card-title fw-semibold text-dark">Unlocode Port</div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a href="/customers" class="text-decoration-none">
        <div class="card h-100 text-center border-0 shadow-sm mars-tile">
          <div class="card-body">
            <i class="bi bi-people-fill mars-tile-icon mb-2" style="font-size: 4.5rem; color: var(--mars-blue);"></i>
            <div class="card-title fw-semibold text-dark">Customers</div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <a href="/wip" class="text-decoration-none">
        <div class="card h-100 text-center border-0 shadow-sm mars-tile">
          <div class="card-body">
            <img src="/images/documentation.png" alt="" class="mars-tile-icon mb-2">
            <div class="card-title fw-semibold text-dark">Guide</div>
          </div>
        </div>
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer'); %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
