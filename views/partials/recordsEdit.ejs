    //HSCode Modal and search system.
        var hscodeSearchTimeout = null;
        var currentHSCodeEl = null;
        var hscodeQuery = '';
        var hscodeSkip = 0;
        var hscodeLoading = false;
        var hscodeHasMore = true;
        var hscodeLastCategory = null;
        var hscodeLastSubCategory = null;

    function openHSCode(el){
        currentHSCodeEl = el;
        document.getElementById('filterHSCode').value = '';
        resetHscodeResults('');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('hscodem')).show();
    }

    function resetHscodeResults(q) {
        hscodeQuery = q;
        hscodeSkip = 0;
        hscodeHasMore = true;
        hscodeLastCategory = null;
        hscodeLastSubCategory = null;
        document.getElementById('hscodeResultsBody').innerHTML = '<tr><td colspan="7" class="text-muted">Loading&hellip;</td></tr>';
        loadMoreHscodeResults(true);
    }

    function loadMoreHscodeResults(isFirstLoad) {
        if (hscodeLoading || !hscodeHasMore) return;
        hscodeLoading = true;
        fetch('/api/hscode/search?q=' + encodeURIComponent(hscodeQuery) + '&skip=' + hscodeSkip)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                hscodeLoading = false;
                hscodeHasMore = data.hasMore;
                hscodeSkip += data.results.length;
                if (isFirstLoad) document.getElementById('hscodeResultsBody').innerHTML = '';
                appendHscodeResults(data.results);
            });
    }

    function appendHscodeResults(results) {
        var tbody = document.getElementById('hscodeResultsBody');
        if (!results.length) {
            if (!tbody.children.length) {
                var emptyRow = document.createElement('tr');
                var emptyCell = document.createElement('td');
                emptyCell.colSpan = 7;
                emptyCell.className = 'text-muted';
                emptyCell.textContent = 'No results';
                emptyRow.appendChild(emptyCell);
                tbody.appendChild(emptyRow);
            }
            return;
        }
        results.forEach(function(h) {
            if (h.category !== hscodeLastCategory) {
                var catRow = document.createElement('tr');
                var catCell = document.createElement('td');
                catCell.colSpan = 7;
                catCell.className = 'fw-bold small text-uppercase';
                catCell.style.background = 'var(--mars-accent-subtle)';
                catCell.style.color = 'var(--mars-accent-dark)';
                catCell.textContent = h.category || '(Uncategorized)';
                catRow.appendChild(catCell);
                tbody.appendChild(catRow);
                hscodeLastCategory = h.category;
                hscodeLastSubCategory = null;
            }
            if (h.subCategory && h.subCategory !== hscodeLastSubCategory) {
                var subRow = document.createElement('tr');
                var subCell = document.createElement('td');
                subCell.colSpan = 7;
                subCell.className = 'small text-muted';
                subCell.style.paddingLeft = '1.5rem';
                subCell.textContent = h.subCategory;
                subRow.appendChild(subCell);
                tbody.appendChild(subRow);
                hscodeLastSubCategory = h.subCategory;
            }
            var tr = document.createElement('tr');
            [h.HSCode, h.Description, h.category, h.subCategory, h.Quantity, h.ImportDutyRate, h.ExciseDutyRate].forEach(function(val) {
                var td = document.createElement('td');
                td.textContent = val || '';
                tr.appendChild(td);
            });
            tr.style.cursor = 'pointer';
            tr.title = 'Double-click to select';
            tr.addEventListener('dblclick', function() {
                selectHSCode(h.HSCode, h.Quantity, h.ImportDutyRate, h.ExciseDutyRate);
            });
            tbody.appendChild(tr);
        });
    }

    document.getElementById('filterHSCode').addEventListener('input', function() {
        var q = this.value;
        clearTimeout(hscodeSearchTimeout);
        hscodeSearchTimeout = setTimeout(function() {
            resetHscodeResults(q);
        }, 250);
    });

    document.getElementById('hscodeScrollBody').addEventListener('scroll', function() {
        if (this.scrollTop + this.clientHeight >= this.scrollHeight - 100) {
            loadMoreHscodeResults(false);
        }
    });

    function selectHSCode(hscode, quantity, importRate, exciseRate){
        if (!currentHSCodeEl) return;
        var row = currentHSCodeEl.closest('tr');
        var newHsCode = hscode.replace(/[.]/g,"");

        currentHSCodeEl.value = newHsCode;
        var unitEl = row.querySelector('.goodsUnit');
        var dutyEl = row.querySelector('.goodsDuty');
        var importDutyEl = row.querySelector('.goodsImportDuty');
        var exciseDutyEl = row.querySelector('.goodsExciseDuty');
        if (unitEl) unitEl.value = (quantity || '').toUpperCase();
        if (dutyEl) dutyEl.value = exciseRate;
        if (importDutyEl) importDutyEl.value = importRate;
        if (exciseDutyEl) exciseDutyEl.value = exciseRate;

        bootstrap.Modal.getOrCreateInstance(document.getElementById('hscodem')).hide();
    }


