<div id="Profile">

  <% if (messages.error) { %>
    <p class="alert alert-danger"><%= messages.error %></p>
  <% } %>

  <form id="profileupdate" action="/profileupdate" method="POST">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body">
        <h5 class="card-title mb-3">Profile Details</h5>
        <p class="text-muted small">Fields marked <span class="text-danger">*</span> are required.</p>

        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" value="<%= username.name %>" required />
          </div>
          <div class="col-md-6">
            <label class="form-label">Email</label>
            <input type="text" name="email" class="form-control" value="<%= username.email %>" readonly />
          </div>
          <div class="col-md-6">
            <label class="form-label">Phone Number</label>
            <input type="text" name="phone" class="form-control" value="<%= username.phone %>" />
          </div>
          <div class="col-md-3">
            <label class="form-label">ID Type <span class="text-danger">*</span></label>
            <select name="idType" class="form-select" required>
              <option value="IC" <%= username.idType === 'IC' ? 'selected' : '' %>>IC</option>
              <option value="PP" <%= username.idType === 'PP' ? 'selected' : '' %>>PP</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">IC/Passport No <span class="text-danger">*</span></label>
            <input type="text" name="icNo" class="form-control" value="<%= username.icNo %>" required />
          </div>
          <div class="col-md-6">
            <label class="form-label">IC Color <span class="text-danger">*</span></label>
            <input type="text" name="icColor" class="form-control" value="<%= username.icColor %>" required />
          </div>
          <div class="col-md-6">
            <label class="form-label">Designation <span class="text-danger">*</span></label>
            <input type="text" name="designation" class="form-control" value="<%= username.designation %>" required />
          </div>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body">
        <h5 class="card-title mb-1">Change Password</h5>
        <p class="text-muted small mb-3">Optional — leave blank to keep your current password.</p>
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Current Password</label>
            <input type="password" name="currentPassword" class="form-control" autocomplete="current-password" />
          </div>
          <div class="col-md-4">
            <label class="form-label">New Password</label>
            <input type="password" name="newPassword" class="form-control" autocomplete="new-password" />
          </div>
          <div class="col-md-4">
            <label class="form-label">Confirm New Password</label>
            <input type="password" name="confirmNewPassword" class="form-control" autocomplete="new-password" />
          </div>
        </div>
      </div>
    </div>

    <button type="submit" class="btn btn-mars">Update Profile</button>
  </form>

</div>
