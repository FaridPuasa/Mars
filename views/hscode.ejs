<% const title = "HS Code" %>
<%- include('partials/head', { title }); %>
<body>
<%- include('partials/dashboard'); %>

<div class="container-fluid py-4" style="max-width: 1400px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">HS Code</h1>
  </div>
  <p><a href="https://tradingacrossborders.mofe.gov.bn/PublishingImages/SitePages/home/BDTTC%202022.pdf" target="_blank" rel="noopener">All HSCode are based on Tariff 2022 under MOFE</a></p>

  <% if (messages.error) { %>
    <p class="alert alert-danger"><%= messages.error %></p>
  <% } %>

  <%- include('partials/pagination', { baseUrl: '/hscode', currentPage, totalPages, q, totalCount }); %>

  <div class="table-responsive">
    <table class="table table-striped table-bordered table-sm align-middle">
      <thead>
        <tr>
          <th scope="col">HSCode</th>
          <th scope="col">Description</th>
          <th scope="col">Category</th>
          <th scope="col">Sub-Category</th>
          <th scope="col">Quantity</th>
          <th scope="col">Rate of Import Duty</th>
          <th scope="col">Rate of Excise Duty</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        <% var lastCategory = null; var lastSubCategory = null; %>
        <% hscode.forEach(function(h) { %>
        <% if (h.category !== lastCategory) { %>
        <tr class="hscode-category-row">
          <td colspan="8"><%= h.category || '(Uncategorized)' %></td>
        </tr>
        <% lastCategory = h.category; lastSubCategory = null; %>
        <% } %>
        <% if (h.subCategory && h.subCategory !== lastSubCategory) { %>
        <tr class="hscode-subcategory-row">
          <td colspan="8"><%= h.subCategory %></td>
        </tr>
        <% lastSubCategory = h.subCategory; %>
        <% } %>
        <tr>
          <td><%= h.HSCode %></td>
          <td><%= h.Description %></td>
          <td class="text-muted small"><%= h.category %></td>
          <td class="text-muted small"><%= h.subCategory %></td>
          <td><%= h.Quantity %></td>
          <td><%= h.ImportDutyRate %></td>
          <td><%= h.ExciseDutyRate %></td>
          <td class="text-nowrap">
            <% if (username.designation === 'Admin') { %>
            <button type="button" class="btn btn-sm btn-outline-danger delete-hscode-btn"
              data-id="<%= h._id %>" data-label="<%= h.HSCode %> - <%= h.Description %>">Delete</button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <%- include('partials/pagination', { baseUrl: '/hscode', currentPage, totalPages, q, totalCount }); %>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteHscodeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" id="deleteHscodeForm" method="POST">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Delete HSCode <strong id="deleteHscodeLabel"></strong>? This cannot be undone.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer'); %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.querySelectorAll('.delete-hscode-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('deleteHscodeLabel').textContent = btn.dataset.label;
      document.getElementById('deleteHscodeForm').action =
        '/hscode/delete/' + btn.dataset.id + '?page=<%= currentPage %>&q=<%= encodeURIComponent(q) %>';
      new bootstrap.Modal(document.getElementById('deleteHscodeModal')).show();
    });
  });
</script>
</body>
</html>
