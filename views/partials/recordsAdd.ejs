    function confirmDeleteGoodsRow(btn) {
        var tbody = document.querySelector("#goodsTable tbody");
        if (tbody.rows.length <= 1) {
            alert("At least one goods row is required.");
            return;
        }
        if (!confirm("Delete this goods row? This cannot be undone.")) {
            return;
        }
        var row = btn.closest("tr");
        row.parentNode.removeChild(row);
        renumberGoodsSerials();
    }

    var draggedGoodsRow = null;

    function goodsDragStart(e) {
        draggedGoodsRow = e.target.closest("tr");
        e.dataTransfer.effectAllowed = "move";
        e.dataTransfer.setData("text/plain", "");
        draggedGoodsRow.classList.add("goods-row-dragging");
    }

    function goodsDragEnd(e) {
        if (draggedGoodsRow) draggedGoodsRow.classList.remove("goods-row-dragging");
        draggedGoodsRow = null;
    }

    (function () {
        var goodsTbody = document.querySelector("#goodsTable tbody");
        if (!goodsTbody) return;

        goodsTbody.addEventListener("dragover", function (e) {
            if (!draggedGoodsRow) return;
            e.preventDefault();
            var targetRow = e.target.closest("tr");
            if (!targetRow || targetRow === draggedGoodsRow || targetRow.parentNode !== goodsTbody) return;
            var rect = targetRow.getBoundingClientRect();
            var before = (e.clientY - rect.top) < (rect.height / 2);
            goodsTbody.insertBefore(draggedGoodsRow, before ? targetRow : targetRow.nextSibling);
        });

        goodsTbody.addEventListener("drop", function (e) {
            if (!draggedGoodsRow) return;
            e.preventDefault();
            renumberGoodsSerials();
        });
    })();

