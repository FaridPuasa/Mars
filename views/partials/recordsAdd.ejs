<div id="Declaration3">
    <div class = "container-fluid" style="padding-top: 50px">
        <div class = "row align-items-start">
            <div class="col-md-1"></div>
            <div class="col-md-10 mars-declaration-wrapper">

    <h3>Add Declaration</h3>
    <form id ="declaration" action = "/declaration3" method="POST">

        <!-- PAGE 1 -->
        <div class="declarationPage">
        <div class="row">
            <div class="col leftcolumn">
                <div class="mars-meta-bar">
                    <div>
                    <label for="date">Date Granted:</label>
                    <% var todayDate = new Date(); %>
                    <% var dd = String(todayDate.getDate()).padStart(2, '0'); %>
                    <% var mm = String(todayDate.getMonth() + 1).padStart(2, '0'); //January is 0! %>
                    <% var yyyy = todayDate.getFullYear(); %>

                    <% todayDate = yyyy + "-" + mm + "-" + dd; %>
                    <input type="date" id="dateGranted" name="dateGranted" value="<%= todayDate %>" size="30"/>
                    </div>
                    <div>
                    <label for="date">Departure Date:</label>
                    <input type="date" id="departureDate" name="departureDate" size="30"/>
                    </div>
                    <div>
                    <!--CEPT Option Normal/Cept-->
                    <label for="date">CEPT:</label>
                    <select name="cept" id="cept">
                        <option value="normal">Normal</option>
                        <option value="cept">CEPT</option>
                    </select>
                    </div>
                </div>
                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Procedure</div>
                    <div class="card-body">
                    <div class="row g-3">
                      <div class="col-md-8">
                        <label class="form-label">Custom Procedure <span class="text-danger">*</span></label>
                        <select name="customsProcedure" id="customsProcedure" class="form-select" onchange="autoCodeCustomProcedure()">
                            <optgroup label="-">
                                <!--code 05--><option value="IMP">IMPORT</option>
                                <!--code 07--><option value="REIMP">RE-IMPORT</option>
                                <!--code 10--><option value="ENTRYTOBOND">ENTRY TO BOND (WAREHOUSE)</option>
                                <!--code 11--><option value="TEMPIMP">TEMPORARY IMPORT</option>
                                <!--code 15--><option value="TEMPIMPEXT">TEMPORARY IMPORT (EXTENSION)</option>
                                <!--code 09--><option value="IMPFROMBOND">IMPORTATION FROM BOND (WAREHOUSE)</option>
                            </optgroup>
                            <optgroup label="-">
                                <!--code 06--><option value="EXP">EXPORT</option>
                                <!--code 08--><option value="REEXP">RE-EXPORT</option>
                                <!--code 16--><option value="TEMPEXP">TEMPORARY EXPORT</option>
                                <!--code 14--><option value="EXPFROMBOND">EXPORT FROM BOND (WAREHOUSE)</option>
                            </optgroup>
                                <!--code 12--><option value="TRANSIT">TRANSIT</option>
                                <!--code 13--><option value="BONDEDMOVGOODS">BONDED MOVEMENT OF GOODS (BETWEEN WAREHOUSE)</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="customsProcedureCode" name="customsProcedureCode" class="form-control" value="05"/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Prev Procedure</label>
                        <select name="previousProcedure" id="previousProcedure" class="form-select" onchange="autoCodePrevProcedure()">
                                <option value=""></option>
                            <optgroup label="-">
                                <!--code 05--><option value="IMP">IMPORT</option>
                                <!--code 07--><option value="REIMP">RE-IMPORT</option>
                                <!--code 10--><option value="ENTRYTOBOND">ENTRY TO BOND (WAREHOUSE)</option>
                                <!--code 11--><option value="TEMPIMP">TEMPORARY IMPORT</option>
                                <!--code 15--><option value="TEMPIMPEXT">TEMPORARY IMPORT (EXTENSION)</option>
                                <!--code 09--><option value="IMPFROMBOND">IMPORTATION FROM BOND (WAREHOUSE)</option>
                            </optgroup>
                            <optgroup label="-">
                                <!--code 06--><option value="EXP">EXPORT</option>
                                <!--code 08--><option value="REEXP">RE-EXPORT</option>
                                <!--code 16--><option value="TEMPEXP">TEMPORARY EXPORT</option>
                                <!--code 14--><option value="EXPFROMBOND">EXPORT FROM BOND (WAREHOUSE)</option>
                            </optgroup>
                                <!--code 12--><option value="TRANSIT">TRANSIT</option>
                                <!--code 13--><option value="BONDEDMOVGOODS">BONDED MOVEMENT OF GOODS (BETWEEN WAREHOUSE)</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="previousProcedureCode" name="previousProcedureCode" class="form-control"/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Dutiable Indicator <span class="text-danger">*</span></label>
                        <select name="dutiableIndicator" id="dutiableIndicator" class="form-select" onchange="autoCodeDutiable()">
                            <!--code A--><option value="A">AIR</option>
                            <!--code B--><option value="N">SEA</option>
                            <!--code C--><option value="L">LAND</option>
                            <!--code D--><option value="P">POSTAL</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="dutiableIndicatorCode" name="dutiableIndicatorCode" class="form-control" value="A"/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Clearance Station <span class="text-danger">*</span></label>
                        <select name="clearanceStation" id="clearanceStation" class="form-select" onchange="autoCodeClearance()">
                            <!--code 611--><option value="BSB">BSB</option>
                            <!--code 603--><option value="BSP WHARF">BSP WHARF</option>
                            <!--code 611--><option value="BSP WHARF + LONG ROOM">BSP WHARF + LONG ROOM</option>
                            <!--code 600--><option value="CUSTOMS HEADQUARTERS">CUSTOMS HEADQUARTERS</option>
                            <!--code 601--><option value="INTERNATIONAL AIRPORT (CARGO)">INTERNATIONAL AIRPORT (CARGO)</option>
                            <!--code 609--><option value="INTERNATIONAL AIRPORT (PASSENGER)">INTERNATIONAL AIRPORT (PASSENGER)</option>
                            <!--code 622--><option value="KUALA BELAIT POST OFFICE">KUALA BELAIT POST OFFICE</option>
                            <!--code 602--><option value="KUALA BELAIT WHARF">KUALA BELAIT WHARF</option>
                            <!--code 631--><option value="KUALA LURAH">KUALA LURAH</option>
                            <!--code 621--><option value="MAIL PROCESSING CENTRE">MAIL PROCESSING CENTRE</option>
                            <!--code 616--><option value="MUARA CONTAINER">MUARA CONTAINER</option>
                            <!--code 617--><option value="MUARA GUARD HOUSE">MUARA GUARD HOUSE</option>
                            <!--code 605--><option value="MUARA PORT">MUARA PORT</option>
                            <!--code 615--><option value="MUARA POST OFFICE">MUARA POST OFFICE</option>
                            <!--code 620--><option value="PUTAT">PUTAT</option>
                            <!--code 608--><option value="SERASA FERRY TERMINAL">SERASA FERRY TERMINAL</option>
                            <!--code 618--><option value="SERASA FERRY NEW TERMINAL">SERASA NEW FERRY TERMINAL</option>
                            <!--code 623--><option value="SERIA POST OFFICE">SERIA POST OFFICE</option>
                            <!--code 612--><option value="SUNGAI TUJOH">SUNGAI TUJOH</option>
                            <!--code 634--><option value="TEMBURONG LABU">TEMBURONG LABU</option>
                            <!--code 614--><option value="TEMBURONG POST OFFICE">TEMBURONG POST OFFICE</option>
                            <!--code 604--><option value="TEMBURONG WHARF (BANGAR)">TEMBURONG WHARF (BANGAR)</option>
                            <!--code 607--><option value="TUTONG POST OFFICE">TUTONG POST OFFICE</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="clearanceStationCode" name="clearanceStationCode" class="form-control" value="611" required/>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Exporter / Consigner</div>
                    <div class="card-body">
                    <div class="mb-3">
                      <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label">Pick existing customer (optional)</label>
                        <a href="/customers" target="_blank" class="small">+ Add customer</a>
                      </div>
                      <select id="exporterCustomerPicker" class="form-select" onchange="fillExporterFromCustomer(this)">
                        <option value="">-- Pick existing customer (optional) --</option>
                        <% for (var e=0; e<consignee.length; e++) { %>
                          <option value="<%= e %>" data-name="<%= consignee[e].name %>" data-address="<%= consignee[e].address %>" data-reg="<%= consignee[e].reg %>" data-country="<%= consignee[e].country %>" data-phone="<%= consignee[e].telephone %>" data-postal="<%= consignee[e].postal %>"><%= consignee[e].name %></option>
                        <% } %>
                      </select>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label">Name</label>
                        <input type="text" id="exporterName" name="exporterName" class="form-control"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <input type="text" id="exporterAddress" name="exporterAddress" class="form-control"/>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Registration</label>
                        <input type="text" id="exporterRegistration" name="exporterRegistration" class="form-control"/>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Country</label>
                        <select id="exporterCountry" name="exporterCountry" class="form-select">
                          <option value=""></option>
                          <% for (var c=0; c<iso_countrycodes.length; c++) { %>
                            <option value="<%= iso_countrycodes[c].name %>"><%= iso_countrycodes[c].name %></option>
                          <% } %>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Telephone</label>
                        <input type="text" id="exporterPhone" name="exporterPhone" class="form-control"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Postal</label>
                        <input type="text" id="exporterPostal" name="exporterPostal" class="form-control"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Transport</label>
                        <input type="text" id="exporterTransport" name="exporterTransport" class="form-control"/>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
            <!-- end left col-->
            <div class="col rightcolumn">
                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Importer / Consignee</div>
                    <div class="card-body">
                    <div class="mb-3">
                      <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label">Pick existing customer</label>
                        <a href="/customers" target="_blank" class="small">+ Add customer</a>
                      </div>
                      <select id="importerCustomerPicker" class="form-select" onchange="fillImporterFromCustomer(this)">
                        <option value="">-- Pick existing customer --</option>
                        <% for (var e=0; e<consignee.length; e++) { %>
                          <option value="<%= e %>" data-name="<%= consignee[e].name %>" data-address="<%= consignee[e].address %>" data-reg="<%= consignee[e].reg %>" data-ic="<%= consignee[e].ic %>" data-iccolor="<%= consignee[e].icColor %>" data-phone="<%= consignee[e].telephone %>" data-postal="<%= consignee[e].postal %>"><%= consignee[e].name %></option>
                        <% } %>
                      </select>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-4">
                        <label class="form-label">Type <span class="text-danger">*</span></label>
                        <select name="importerType" id="importerType" class="form-select" onchange="autoImporterIdReg()">
                            <option value="TRDR">TRDR</option>
                            <option value="INDV">INDV</option>
                        </select>
                      </div>
                      <div class="col-md-8"></div>
                      <div class="col-md-6">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" id="importerName" name="importerName" class="form-control" required/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Address <span class="text-danger">*</span></label>
                        <textarea id="importerAddress" name="importerAddress" class="form-control" rows="2" required></textarea>
                      </div>
                      <div class="col-md-6" id="importerTRDR2">
                        <label class="form-label" id="importerTRDR1">Reg <span class="text-danger">*</span></label>
                        <input type="text" id="regTraderCoyRegNo" name="regTraderCoyRegNo" class="form-control"/>
                      </div>
                      <div class="col-md-6" id="importerINDV2" style="display:none">
                        <label class="form-label" id="importerINDV1">IC/PP <span class="text-danger">*</span></label>
                        <input type="text" id="importerRegistration" name="importerRegistration" class="form-control mb-2"/>
                        <label class="form-label">IC Color</label>
                        <input type="text" id="importerICColor" name="importerICColor" class="form-control"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Telephone <span class="text-danger">*</span></label>
                        <input type="text" id="importerPhone" name="importerPhone" class="form-control"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Postal <span class="text-danger">*</span></label>
                        <input type="text" id="importerPostal" name="importerPostal" class="form-control"/>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Agent</div>
                    <div class="card-body">
                    <div class="mb-3">
                      <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label">Pick existing customer</label>
                        <a href="/customers" target="_blank" class="small">+ Add customer</a>
                      </div>
                      <select id="agentCustomerPicker" class="form-select" onchange="fillAgentFromCustomer(this)">
                        <option value="">-- Pick existing customer --</option>
                        <% for (var e=0; e<consignee.length; e++) { %>
                          <option value="<%= e %>" data-name="<%= consignee[e].name %>" data-address="<%= consignee[e].address %>" data-reg="<%= consignee[e].reg %>" data-phone="<%= consignee[e].telephone %>" data-postal="<%= consignee[e].postal %>"><%= consignee[e].name %></option>
                        <% } %>
                      </select>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" id="agentName" name="agentName" class="form-control" value="GLOBEX GLOBAL LOGISTICS SDN BHD"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Address <span class="text-danger">*</span></label>
                        <input type="text" id="agentAddress" name="agentAddress" class="form-control" value="UNIT 9, BLOCK A, SPG 188 JALAN BABU RAJA"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Registration <span class="text-danger">*</span></label>
                        <input type="text" id="agentRegistration" name="agentRegistration" class="form-control" value="RC/00007286"/>
                      </div>
                      <div class="col-md-3">
                        <label class="form-label">Telephone <span class="text-danger">*</span></label>
                        <input type="text" id="agentPhone" name="agentPhone" class="form-control" value="2332065"/>
                      </div>
                      <div class="col-md-3">
                        <label class="form-label">Postal <span class="text-danger">*</span></label>
                        <input type="text" id="agentPostal" name="agentPostal" class="form-control" value="BE1318"/>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
        </div>
        </div>
        <!-- PAGE 1 ENDS -->
        <!-- PAGE 2 -->
        <div class="declarationPage">
        <div class="row">
            <div class="col leftcolumn">
                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Transport</div>
                    <div class="card-body">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label">Arrival Date <span class="text-danger">*</span></label>
                        <input type="date" id="arrivalDate" name="arrivalDate" class="form-control" required/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Container No</label>
                        <input type="text" id="containerNo" name="containerNo" class="form-control"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Vessel Number <span class="text-danger">*</span></label>
                        <input type="text" id="vesselNo" name="vesselNo" class="form-control" required/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Vessel Name <span class="text-danger">*</span></label>
                        <input type="text" id="vesselName" name="vesselName" class="form-control" required/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">BL/DO/AWB <span class="text-danger">*</span></label>
                        <input type="text" id="bldoawb" name="bldoawb" class="form-control" required/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">HB/HAWB</label>
                        <input type="text" id="hbhawb" name="hbhawb" class="form-control"/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Country Shipment <span class="text-danger">*</span></label>
                        <select id="countryShipment" name="countryShipment" class="form-select" required onchange="fillCountryCode(this, 'countryShipmentCode')">
                            <option value=""></option>
                            <% for (var c=0; c<iso_countrycodes.length; c++) { %>
                              <option value="<%= iso_countrycodes[c].name %>" data-code="<%= iso_countrycodes[c].alpha2 %>"><%= iso_countrycodes[c].name %></option>
                            <% } %>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="countryShipmentCode" name="countryShipmentCode" class="form-control" readonly/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Country Destination <span class="text-danger">*</span></label>
                        <select id="countryDestination" name="countryDestination" class="form-select" required onchange="fillCountryCode(this, 'countryDestinationCode')">
                            <option value=""></option>
                            <% for (var c=0; c<iso_countrycodes.length; c++) { %>
                              <option value="<%= iso_countrycodes[c].name %>" data-code="<%= iso_countrycodes[c].alpha2 %>"><%= iso_countrycodes[c].name %></option>
                            <% } %>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="countryDestinationCode" name="countryDestinationCode" class="form-control" readonly/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Port of Entry <span class="text-danger">*</span></label>
                        <input type="text" id="portOfEntry" name="portOfEntry" class="form-control" ondblclick="openShipmentCode('portOfEntry', 'portOfEntryCode')" required/>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="portOfEntryCode" name="portOfEntryCode" class="form-control" required/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Port of Discharge <span class="text-danger">*</span></label>
                        <input type="text" id="portOfDischarge" name="portOfDischarge" class="form-control" onchange='getPort(this.value)' required/>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="portOfDischargeCode" name="portOfDischargeCode" class="form-control" required/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Place Release</label>
                        <input type="text" id="placeRelease" name="placeRelease" class="form-control"/>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="placeReleaseCode" name="placeReleaseCode" class="form-control"/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Place Receipt</label>
                        <input type="text" id="placeReceipt" name="placeReceipt" class="form-control"/>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="placeReceiptCode" name="placeReceiptCode" class="form-control"/>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
            <!-- end left col-->
            <div class="col rightcolumn">
                <div class="card mars-card border-0 shadow-sm mb-3">
                  <div class="mars-card-header">Supporting Documents</div>
                    <div class="card-body">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label">Exchange Currency <span class="text-danger">*</span></label>
                        <input type="text" id="exchangeCurrency" name="exchangeCurrency" class="form-control" placeholder="Currency"/>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Exchange Rate <span class="text-danger">*</span></label>
                        <input type="text" id="exchangeRate" name="exchangeRate" class="form-control" placeholder="Rate"/>
                      </div>
                      <div class="col-md-12">
                        <label class="form-label">Prev Declaration No</label>
                        <input type="text" id="prevDeclarationNo" name="prevDeclarationNo" class="form-control"/>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Duty Exem</label>
                        <select name="dutyExem" class="form-select">
                                <option></option>
                                <option value="Y">Y</option>
                                <option value="N">N</option>
                        </select>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Letter</label>
                        <input type="text" id="letter" name="letter" class="form-control"/>
                      </div>
                      <div class="col-md-8">
                        <label class="form-label">Port Of Exit</label>
                        <input type="text" id="portOfExit" name="portOfExit" class="form-control"/>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label">Code</label>
                        <input type="text" id="portOfExitCode" name="portOfExitCode" class="form-control"/>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
        </div>
        </div>
        <!--Page 2 Ends-->
        <!-- PAGE 3 -->
        <div class="declarationPage">
            <div class="row">
                <div class="col leftcolumn">
                    <div class="card mars-card border-0 shadow-sm mb-3">
                      <div class="mars-card-header">For Temporary Import</div>
                        <div class="card-body">
                        <div class="row g-3">
                          <div class="col-md-8">
                            <label class="form-label">Type of Application</label>
                            <select name="typeOfApplication" class="form-select">
                                <option value=""></option>
                                <option value="DEM">DEM</option>
                                <option value="TSP">TSP</option>
                                <option value="ESH">ESH</option>
                                <option value="LSP">LSP</option>
                            </select>
                          </div>
                          <div class="col-md-4">
                            <label class="form-label">Granted Period (Mon)</label>
                            <input type="text" id="grantedPeriod" name="grantedPeriod" class="form-control"/>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label">Est. Date of Export</label>
                            <input type="date" id="estDateOfExport" name="estDateOfExport" class="form-control"/>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label">Place Export</label>
                            <input type="text" id="placeExport" name="placeExport" class="form-control"/>
                          </div>
                          <div class="col-md-12">
                            <label class="form-label">Project Name</label>
                            <input type="text" id="projectName" name="projectName" class="form-control"/>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label">Project Date From</label>
                            <input type="date" id="projectDateFrom" name="projectDateFrom" class="form-control"/>
                          </div>
