<div class="container-fluid py-4" style="max-width: 1400px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">BDNSW Declarations</h1>
    <a href="/bdnswadd" class="btn btn-mars">Add Declaration</a>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle bg-white" id="tableId">
      <thead class="table-light">
        <tr>
          <th style="width: 30px;"></th>
          <th>Date</th>
          <th>Invoice No</th>
          <th>Importer</th>
          <th>Vessel</th>
          <th>Country</th>
          <th>Agent</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (declaration3) { %>
          <% declaration3.forEach(function(d, i) { %>
          <tr>
            <td>
              <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" data-bs-toggle="collapse" data-bs-target="#details<%= i %>" aria-expanded="false" aria-controls="details<%= i %>" title="Show details">
                <i class="bi bi-chevron-right toggle-caret text-muted"></i>
              </button>
            </td>
            <td><%= d.declarationDate %></td>
            <td><%= d.Goods[0].goodsInvoiceNo %></td>
            <td><%= d.Importer.importerName %></td>
            <td><%= d.Transport.vesselName %></td>
            <td><%= d.Transport.countryShipment %></td>
            <td><%= d.Agent.agentName %></td>
            <td class="text-end text-nowrap">
              <a href="/bdnswedit/<%= d._id %>" class="btn btn-sm btn-outline-primary">Edit</a>
              <a href="/downloadXML/<%= d._id %>/<%= d.Goods[0].goodsInvoiceNo %>" class="btn btn-sm btn-outline-secondary">Download XML</a>
            </td>
          </tr>
          <tr class="collapse" id="details<%= i %>">
            <td colspan="8" class="bg-light p-3">

              <h6 class="text-muted text-uppercase small mb-2">Declaration Details</h6>
              <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
                <div><div class="text-muted small">Procedure Code</div><div><%= d.Procedure.customsProcedureCode %></div></div>
                <div><div class="text-muted small">Dutiable Indicator</div><div><%= d.Procedure.dutiableIndicatorCode %></div></div>
                <div><div class="text-muted small">Clearance Station</div><div><%= d.Procedure.clearanceStation %> (<%= d.Procedure.clearanceStationCode %>)</div></div>
                <div><div class="text-muted small">CEPT</div><div><%= d.cept %></div></div>
                <div><div class="text-muted small">Country Code</div><div><%= d.Transport.countryShipmentCode %></div></div>
                <div><div class="text-muted small">Vessel No / Voyage</div><div><%= d.Transport.vesselNo %></div></div>
                <div><div class="text-muted small">BL/DO/AWB No</div><div><%= d.Transport.bldoawb %></div></div>
                <div><div class="text-muted small">HB/HAWB</div><div><%= d.Transport.hbhawb %></div></div>
                <div><div class="text-muted small">Importer Type</div><div><%= d.Importer.importerType %></div></div>
                <div><div class="text-muted small">Importer IC Color</div><div><%= d.Importer.importerICColor %></div></div>
                <div><div class="text-muted small">Exchange Currency / Rate</div><div><%= d.SupportingDocuments.exchangeCurrency %> <%= d.SupportingDocuments.exchangeRate %></div></div>
                <div><div class="text-muted small">Date Granted</div><div><%= d.dateGranted %></div></div>
                <div><div class="text-muted small">Insurance</div><div><%= d.DeclarationGoods.insuranceAmount %> <%= d.DeclarationGoods.insuranceCurrency %></div></div>
                <div><div class="text-muted small">Freight</div><div><%= d.DeclarationGoods.freightAmount %> <%= d.DeclarationGoods.freightCurrency %></div></div>
                <div><div class="text-muted small">Other Charges</div><div><%= d.DeclarationGoods.otherCharges %></div></div>
                <div><div class="text-muted small">Posted By</div><div><%= d.postedBy %></div></div>
                <div><div class="text-muted small">Declarant</div><div><%= d.Declarant.declarantName %></div></div>
                <div><div class="text-muted small">Declarant IC No / Color</div><div><%= d.Declarant.declarantICNo %> <%= d.Declarant.declarantICColor %></div></div>
                <div><div class="text-muted small">Declarant Designation</div><div><%= d.Declarant.declarantDesignation %></div></div>
              </div>

              <h6 class="text-muted text-uppercase small mb-2">Goods</h6>
              <div class="table-responsive">
                <table class="table table-sm table-bordered bg-white mb-0">
                  <thead>
                    <tr>
                      <th>Item</th>
                      <th>HS Code</th>
                      <th>Description</th>
                      <th>O. Country</th>
                      <th>Package No/Unit</th>
                      <th>Qty</th>
                      <th>Unit</th>
                      <th>Weight</th>
                      <th>Amount</th>
                      <th>CIF</th>
                      <th>Duty</th>
                      <th>Import Duty</th>
                      <th>Excise Duty</th>
                      <th>Invoice No</th>
                      <th>Container No</th>
                      <th>Shipping Mark</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% d.Goods.forEach(function(g) { %>
                    <tr>
                      <td><%= g.goodsSerialNo %></td>
                      <td><%= g.hsCode %></td>
                      <td><%= g.goodsDescription %></td>
                      <td><%= g.countryOrigin %> (<%= g.countryCode %>)</td>
                      <td><%= g.goodsPackageNo %> <%= g.goodsPackageUnit %></td>
                      <td><%= g.goodsQuantity %></td>
                      <td><%= g.goodsUnit %></td>
                      <td><%= g.goodsWeight %></td>
                      <td><%= g.goodsAmount %></td>
                      <td><%= g.goodsCIF %></td>
                      <td><%= g.goodsDuty %> (<%= g.goodsDutyAmount %>)</td>
                      <td><%= g.goodsImportDuty %></td>
                      <td><%= g.goodsExciseDuty %></td>
                      <td><%= g.goodsInvoiceNo %></td>
                      <td><%= g.goodsContainerNo %></td>
                      <td><%= g.goodsShippingMark %></td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

            </td>
          </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll('#tableId [data-bs-toggle="collapse"]').forEach(function(row) {
    var target = document.querySelector(row.getAttribute('data-bs-target'));
    var caret = row.querySelector('.toggle-caret');
    target.addEventListener('show.bs.collapse', function() {
      caret.classList.remove('bi-chevron-right');
      caret.classList.add('bi-chevron-down');
    });
    target.addEventListener('hide.bs.collapse', function() {
      caret.classList.remove('bi-chevron-down');
      caret.classList.add('bi-chevron-right');
    });
  });
</script>
