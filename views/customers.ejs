<% const title = "Customers" %>
<%- include('partials/head', { title }); %>
<body>
<%- include('partials/dashboard'); %>

<div class="container-fluid py-4" style="max-width: 1200px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customers</h1>
    <button type="button" class="btn btn-mars" data-bs-toggle="modal" data-bs-target="#addCustomerModal">Add Customer</button>
  </div>
  <p class="text-muted">Used to auto-fill Exporter, Importer/Consignee and Agent details on BDNSW declarations.</p>

  <% if (messages.error) { %>
    <p class="alert alert-danger"><%= messages.error %></p>
  <% } %>

  <%- include('partials/pagination', { baseUrl: '/customers', currentPage, totalPages, q, totalCount }); %>

  <div class="table-responsive">
    <table class="table table-striped table-bordered table-sm align-middle">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Address</th>
          <th scope="col">Registration</th>
          <th scope="col">Country</th>
          <th scope="col">Telephone</th>
          <th scope="col">Postal</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        <% customers.forEach(function(c) { %>
        <tr>
          <td><%= c.name %></td>
          <td><%= c.address %></td>
          <td><%= c.reg %></td>
          <td><%= c.country %></td>
          <td><%= c.telephone %></td>
          <td><%= c.postal %></td>
          <td class="text-nowrap">
            <button type="button" class="btn btn-sm btn-outline-primary edit-customer-btn"
              data-id="<%= c._id %>"
              data-name="<%= c.name %>"
              data-address="<%= c.address %>"
              data-reg="<%= c.reg %>"
              data-country="<%= c.country %>"
              data-telephone="<%= c.telephone %>"
              data-postal="<%= c.postal %>">Edit</button>
            <% if (username.designation === 'Admin') { %>
            <button type="button" class="btn btn-sm btn-outline-danger delete-customer-btn"
              data-id="<%= c._id %>" data-label="<%= c.name %>">Delete</button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <%- include('partials/pagination', { baseUrl: '/customers', currentPage, totalPages, q, totalCount }); %>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addCustomerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" action="/customers/create" method="POST">
      <div class="modal-header">
        <h5 class="modal-title">Add Customer</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" name="page" value="<%= currentPage %>">
        <input type="hidden" name="q" value="<%= q %>">
        <div class="mb-2"><label class="form-label">Name</label><input type="text" name="name" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Address</label><input type="text" name="address" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Registration</label><input type="text" name="reg" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Country</label><input type="text" name="country" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Telephone</label><input type="text" name="telephone" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Postal</label><input type="text" name="postal" class="form-control" required></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-mars">Add</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editCustomerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" action="/customers/update" method="POST">
      <div class="modal-header">
        <h5 class="modal-title">Edit Customer</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" name="_id" id="editCustomerId">
        <input type="hidden" name="page" value="<%= currentPage %>">
        <input type="hidden" name="q" value="<%= q %>">
        <div class="mb-2"><label class="form-label">Name</label><input type="text" name="name" id="editCustomerName" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Address</label><input type="text" name="address" id="editCustomerAddress" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Registration</label><input type="text" name="reg" id="editCustomerReg" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Country</label><input type="text" name="country" id="editCustomerCountry" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Telephone</label><input type="text" name="telephone" id="editCustomerTelephone" class="form-control" required></div>
        <div class="mb-2"><label class="form-label">Postal</label><input type="text" name="postal" id="editCustomerPostal" class="form-control" required></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-mars">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteCustomerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" id="deleteCustomerForm" method="POST">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Delete customer <strong id="deleteCustomerLabel"></strong>? This cannot be undone.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer'); %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.querySelectorAll('.edit-customer-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('editCustomerId').value = btn.dataset.id;
      document.getElementById('editCustomerName').value = btn.dataset.name;
      document.getElementById('editCustomerAddress').value = btn.dataset.address;
      document.getElementById('editCustomerReg').value = btn.dataset.reg;
      document.getElementById('editCustomerCountry').value = btn.dataset.country;
      document.getElementById('editCustomerTelephone').value = btn.dataset.telephone;
      document.getElementById('editCustomerPostal').value = btn.dataset.postal;
      new bootstrap.Modal(document.getElementById('editCustomerModal')).show();
    });
  });

  document.querySelectorAll('.delete-customer-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('deleteCustomerLabel').textContent = btn.dataset.label;
      document.getElementById('deleteCustomerForm').action =
        '/customers/delete/' + btn.dataset.id + '?page=<%= currentPage %>&q=<%= encodeURIComponent(q) %>';
      new bootstrap.Modal(document.getElementById('deleteCustomerModal')).show();
    });
  });
</script>
</body>
</html>
