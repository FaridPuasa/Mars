<%
  // Display-only formatting (YYYY-MM-DD -> DD.MM.YYYY). Never used for stored values or XML output.
  function formatDateDisplay(dateStr) {
    if (!dateStr) return dateStr;
    var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(dateStr);
    if (!m) return dateStr;
    return m[3] + '.' + m[2] + '.' + m[1];
  }
%>
<div class="container-fluid py-4" style="max-width: 1400px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">BDNSW Declarations</h1>
    <a href="/bdnswadd" class="btn btn-mars">Add Declaration</a>
  </div>

  <form action="/bdnsw" method="GET" class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">Invoice No</label>
          <input type="text" name="invoiceNo" class="form-control form-control-sm" value="<%= filters.invoiceNo %>" placeholder="Invoice No">
        </div>
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">Importer</label>
          <input type="text" name="importer" class="form-control form-control-sm" value="<%= filters.importer %>" placeholder="Importer">
        </div>
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">Vessel</label>
          <input type="text" name="vessel" class="form-control form-control-sm" value="<%= filters.vessel %>" placeholder="Vessel">
        </div>
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">Country</label>
          <input type="text" name="country" class="form-control form-control-sm" value="<%= filters.country %>" placeholder="Country">
        </div>
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">Agent</label>
          <input type="text" name="agent" class="form-control form-control-sm" value="<%= filters.agent %>" placeholder="Agent">
        </div>
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">Date From</label>
          <input type="date" name="dateFrom" class="form-control form-control-sm" value="<%= filters.dateFrom %>">
        </div>
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">Date To</label>
          <input type="date" name="dateTo" class="form-control form-control-sm" value="<%= filters.dateTo %>">
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <div class="form-check">
            <input type="checkbox" class="form-check-input" id="mineCheckbox" name="mine" value="1" <%= filters.mine === '1' ? 'checked' : '' %>>
            <label class="form-check-label small" for="mineCheckbox">My declarations only</label>
          </div>
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
          <button type="submit" class="btn btn-mars btn-sm">Search</button>
          <a href="/bdnsw" class="btn btn-secondary btn-sm">Clear</a>
        </div>
      </div>
    </div>
  </form>

  <div class="table-responsive">
    <table class="table table-hover align-middle bg-white" id="tableId">
      <thead class="table-light">
        <tr>
          <th style="width: 30px;"></th>
          <th>Date</th>
          <th>Invoice No</th>
          <th>Importer</th>
          <th>Vessel</th>
          <th>Country</th>
          <th>Agent</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (declaration3) { %>
          <% declaration3.forEach(function(d, i) { %>
          <tr>
            <td>
              <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" data-bs-toggle="collapse" data-bs-target="#details<%= i %>" aria-expanded="false" aria-controls="details<%= i %>" title="Show details">
                <i class="bi bi-chevron-right toggle-caret text-muted"></i>
              </button>
            </td>
            <td><%= formatDateDisplay(d.declarationDate) %></td>
            <td><%= d.Goods[0].goodsInvoiceNo %></td>
            <td><%= d.Importer.importerName %></td>
            <td><%= d.Transport.vesselName %></td>
            <td><%= d.Transport.countryShipment %></td>
            <td><%= d.Agent.agentName %></td>
            <td class="text-end text-nowrap">
              <a href="/bdnswedit/<%= d._id %>" class="btn btn-sm btn-mars-blue">Edit</a>
              <a href="/downloadXML/<%= d._id %>/<%= d.Goods[0].goodsInvoiceNo %>" class="btn btn-sm btn-success">Download XML</a>
              <% if (username.designation === 'Admin') { %>
              <button type="button" class="btn btn-sm btn-danger delete-declaration-btn"
                data-id="<%= d._id %>" data-label="<%= d.Goods[0].goodsInvoiceNo %> - <%= d.Importer.importerName %>">Delete</button>
              <% } %>
            </td>
          </tr>
          <tr class="collapse" id="details<%= i %>">
            <td colspan="8" class="bg-light p-3">

              <h6 class="text-muted text-uppercase small mb-2">Declaration Details</h6>

              <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size:0.7rem;">Procedure</div>
              <div class="row row-cols-2 row-cols-md-4 g-3 mb-3">
                <div><div class="text-muted small">Procedure Code</div><div><%= d.Procedure.customsProcedureCode %></div></div>
                <div><div class="text-muted small">Dutiable Indicator</div><div><%= d.Procedure.dutiableIndicatorCode %></div></div>
                <div><div class="text-muted small">Clearance Station</div><div><%= d.Procedure.clearanceStation %> (<%= d.Procedure.clearanceStationCode %>)</div></div>
                <div><div class="text-muted small">CEPT</div><div><%= d.cept %></div></div>
              </div>

              <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size:0.7rem;">Importer</div>
              <div class="row row-cols-2 row-cols-md-4 g-3 mb-3">
                <div><div class="text-muted small">Importer Type</div><div><%= d.Importer.importerType %></div></div>
                <div><div class="text-muted small">Importer IC Color</div><div><%= d.Importer.importerICColor %></div></div>
              </div>

              <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size:0.7rem;">Transport</div>
              <div class="row row-cols-2 row-cols-md-4 g-3 mb-3">
                <div><div class="text-muted small">Country Code</div><div><%= d.Transport.countryShipmentCode %></div></div>
                <div><div class="text-muted small">Vessel No / Voyage</div><div><%= d.Transport.vesselNo %></div></div>
                <div><div class="text-muted small">BL/DO/AWB No</div><div><%= d.Transport.bldoawb %></div></div>
                <div><div class="text-muted small">HB/HAWB</div><div><%= d.Transport.hbhawb %></div></div>
              </div>

              <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size:0.7rem;">Financials</div>
              <div class="row row-cols-2 row-cols-md-4 g-3 mb-3">
                <div><div class="text-muted small">Exchange Currency / Rate</div><div><%= d.SupportingDocuments.exchangeCurrency %> <%= d.SupportingDocuments.exchangeRate %></div></div>
                <div><div class="text-muted small">Insurance</div><div><%= d.DeclarationGoods.insuranceAmount %> <%= d.DeclarationGoods.insuranceCurrency %></div></div>
                <div><div class="text-muted small">Freight</div><div><%= d.DeclarationGoods.freightAmount %> <%= d.DeclarationGoods.freightCurrency %></div></div>
                <div><div class="text-muted small">Other Charges</div><div><%= d.DeclarationGoods.otherCharges %></div></div>
              </div>

              <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size:0.7rem;">Declarant</div>
              <div class="row row-cols-2 row-cols-md-4 g-3 mb-3">
                <div><div class="text-muted small">Declarant</div><div><%= d.Declarant.declarantName %></div></div>
                <div><div class="text-muted small">Declarant IC No / Color</div><div><%= d.Declarant.declarantICNo %> <%= d.Declarant.declarantICColor %></div></div>
                <div><div class="text-muted small">Declarant Designation</div><div><%= d.Declarant.declarantDesignation %></div></div>
              </div>

              <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size:0.7rem;">Record Info</div>
              <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
                <div><div class="text-muted small">Date Granted</div><div><%= formatDateDisplay(d.dateGranted) %></div></div>
                <div><div class="text-muted small">Posted By</div><div><%= d.postedBy %></div></div>
              </div>

              <h6 class="text-muted text-uppercase small mb-2">Goods</h6>
              <div class="table-responsive">
                <table class="table table-sm table-bordered bg-white mb-0">
                  <thead>
                    <tr>
                      <th>Item</th>
                      <th>HS Code</th>
                      <th>Description</th>
                      <th>O. Country</th>
                      <th>Package No/Unit</th>
                      <th>Qty</th>
                      <th>Unit</th>
                      <th>Weight</th>
                      <th>Amount</th>
                      <th>Invoice No</th>
                      <th>CIF</th>
                      <th>Duty</th>
                      <th>Import Duty</th>
                      <th>Excise Duty</th>
                      <th>Shipping Mark</th>
                      <th>Container No</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% d.Goods.forEach(function(g) { %>
                    <tr>
                      <td><%= g.goodsSerialNo %></td>
                      <td><%= g.hsCode %></td>
                      <td><%= g.goodsDescription %></td>
                      <td><%= g.countryOrigin %> (<%= g.countryCode %>)</td>
                      <td><%= g.goodsPackageNo %> <%= g.goodsPackageUnit %></td>
                      <td><%= g.goodsQuantity %></td>
                      <td><%= g.goodsUnit %></td>
                      <td><%= g.goodsWeight %></td>
                      <td><%= g.goodsAmount %></td>
                      <td><%= g.goodsInvoiceNo %></td>
                      <td><%= g.goodsCIF %></td>
                      <td><%= g.goodsDuty %> (<%= g.goodsDutyAmount %>)</td>
                      <td><%= g.goodsImportDuty %></td>
                      <td><%= g.goodsExciseDuty %></td>
                      <td><%= g.goodsShippingMark %></td>
                      <td><%= g.goodsContainerNo %></td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

            </td>
          </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteDeclarationModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" id="deleteDeclarationForm" method="POST">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Delete declaration <strong id="deleteDeclarationLabel"></strong>? This cannot be undone.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.querySelectorAll('#tableId [data-bs-toggle="collapse"]').forEach(function(row) {
    var target = document.querySelector(row.getAttribute('data-bs-target'));
    var caret = row.querySelector('.toggle-caret');
    target.addEventListener('show.bs.collapse', function() {
      caret.classList.remove('bi-chevron-right');
      caret.classList.add('bi-chevron-down');
    });
    target.addEventListener('hide.bs.collapse', function() {
      caret.classList.remove('bi-chevron-down');
      caret.classList.add('bi-chevron-right');
    });
  });

  document.querySelectorAll('.delete-declaration-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('deleteDeclarationLabel').textContent = btn.dataset.label;
      document.getElementById('deleteDeclarationForm').action = '/declaration3/delete/' + btn.dataset.id;
      new bootstrap.Modal(document.getElementById('deleteDeclarationModal')).show();
    });
  });
</script>
